# AuditCanvas environment (template only — never commit real values).
# Copy to .env.local for local development.

# Meta Model API (Muse Spark auditor layer).
# NIGHT 0 TODO: verify the exact model ID available on the account and
# whether structured outputs are supported. Do not assume muse-spark-1.1
# or muse-spark-1.3; set whatever the account actually exposes.
META_API_KEY=
META_MODEL_ID=
META_API_BASE=https://api.meta.ai/v1

# Auditor provider selection (server env only, never client input).
# 'meta' (default) is the submission provider. 'gemini' selects the
# Gemini dev stand-in used to prove the auditor/refutation contracts
# before the Meta key verification — never the public demo path.
AUDITOR_PROVIDER=meta

# Gemini stand-in (only used when AUDITOR_PROVIDER=gemini). Key is
# server-side only; model defaults to gemini-3.8-flash with an
# automatic fallback to gemini-3.5-flash-lite on capacity errors.
GEMINI_API_KEY=
GEMINI_MODEL=

# HMAC secret for signing scan step bundles (security fix H1). The
# /step route signs every bundle it returns; /finalize and the
# download routes verify the signatures before trusting bundle
# contents. Set a long random value in production BEFORE deploying
# the signing code: when unset, an ephemeral per-process secret is
# used and signatures do not survive instance restarts (in-flight
# scans then fail verification and must be restarted). Rotating the
# secret likewise invalidates in-flight scans, which is acceptable.
BUNDLE_SIGNING_SECRET=

# Server-side allowlist of OUR OWN demo targets (exact hostnames) that may
# be scanned with the full check set and, for local development only,
# reached on loopback. User-supplied targets can never enter this list.
# Comma-separated hostnames, e.g. "localhost,127.0.0.1".
AUDITCANVAS_DEMO_HOSTS=localhost,127.0.0.1
